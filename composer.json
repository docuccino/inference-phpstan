{
    "name": "docuccino/inference-phpstan",
    "description": "PHPStan and Larastan type inference for Docuccino: infers response and exception shapes from the real types in your code.",
    "type": "library",
    "keywords": [
        "openapi",
        "api-documentation",
        "phpstan",
        "larastan",
        "static-analysis",
        "type-inference",
        "uir",
        "scramble-alternative"
    ],
    "homepage": "https://docuccino.app",
    "license": "MIT",
    "authors": [
        {
            "name": "Tom Martin"
        }
    ],
    "support": {
        "issues": "https://github.com/docuccino/docuccino/issues",
        "source": "https://github.com/docuccino/docuccino"
    },
    "require": {
        "php": "^8.3",
        "docuccino/core": "self.version",
        "docuccino/attributes": "self.version",
        "larastan/larastan": "^3.10",
        "nikic/php-parser": "^5",
        "phpstan/phpstan": "~2.2.0 || ~2.3.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Docuccino\\Inference\\PhpStan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Docuccino\\Inference\\PhpStan\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
